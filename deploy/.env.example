# Hostname players use. "localhost" for testing on your own machine.
DOMAIN=localhost

# "internal" for a self-signed certificate (local testing), or your email
# address to get a Let's Encrypt certificate for a public DOMAIN.
TLS=internal

# Port players enter in the login window. Behind Cloudflare's proxy use one of
# the ports it forwards, such as 2053 (7171 is not one of them).
LOGIN_PORT=7171

# Database password for the server's database user. Pick something random.
DB_PASSWORD=change-me

# Public IPv4 address handed to desktop clients. Browser clients ignore it.
PUBLIC_IP=127.0.0.1

# Optional
SERVER_NAME=
MOTD=
