<?xml version="1.0" encoding="UTF-8"?>
<creaturescripts>
	<event type="login" name="PlayerLogin" script="login.lua"/>
	<event type="login" name="SyncOutfit" script="syncoutfit.lua"/>
	<event type="logout" name="PlayerLogout" script="logout.lua" />
	<event type="login" name="FirstItems" script="firstitems.lua"/>
	<event type="login" name="RegenerateStamina" script="regeneratestamina.lua" />
	<event type="death" name="PlayerDeath" script="playerdeath.lua"/>
	<event type="login" name="OfflineTraining" script="offlinetraining.lua" />
		
	<!-- Daily hunts (ot-server#21): monsters="all" registers it on every monster -->
	<event type="death" name="DailyHuntKill" monsters="all" script="daily_hunts.lua" />
	<event type="login" name="DailyHuntLogin" script="daily_hunts_login.lua" />
	<event type="extendedopcode" name="DailyHuntOpcode" script="daily_hunts_opcode.lua" />

	<!-- Achievements (ot-server#30) -->
	<event type="login" name="AchievementLogin" script="achievements.lua" />
	<event type="advance" name="AchievementAdvance" script="achievements.lua" />
	<event type="death" name="AchievementDeath" script="achievements.lua" />

	<!-- Moments: screenshots in the client (ot-server#52) -->
	<event type="login" name="MomentLogin" script="moments.lua" />
	<event type="advance" name="MomentAdvance" script="moments.lua" />
	<event type="preparedeath" name="MomentPrepareDeath" script="moments.lua" />
	<event type="kill" name="MomentKill" script="moments.lua" />

	<!-- Killing In The Name Of Quest -->
	<event type="death" name="KillingInTheNameOf" script="killing_in_the_name_of.lua" />
</creaturescripts>
